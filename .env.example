# ==========================================
# Mission Save Our 20s - Environment Templates
# ==========================================
#
# This project uses environment variables for both the backend (Django) 
# and the frontend (Nuxt 3).
#
# To set up your local environment:
# 1. Copy backend/.env.example to backend/.env and adjust values.
# 2. Copy frontend/.env.example to frontend/.env and adjust values.
#
# Alternatively, you can define them in your docker-compose or shell.

# --- Backend (Django) ---
# See backend/.env.example
# SECRET_KEY=your-django-secret-key-here
# DEBUG=True

# --- Frontend (Nuxt 3) ---
# See frontend/.env.example
# API_BASE=http://localhost:8000/api
